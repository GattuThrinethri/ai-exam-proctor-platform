# ====================================================
# Frontend Environment Configuration (Vercel & Local)
# ====================================================

# Production Backend API URL
# Used for client-side API requests and Next.js rewrites
# Local: http://127.0.0.1:8001
# Production (Render): https://ai-exam-proctor-platform-backend.onrender.com
NEXT_PUBLIC_API_URL=https://ai-exam-proctor-platform-backend.onrender.com

# Optional: Server-side Next.js rewrite target (defaults to NEXT_PUBLIC_API_URL if unset)
BACKEND_URL=https://ai-exam-proctor-platform-backend.onrender.com

# Optional: Dedicated WebSocket URL for proctoring connection
# (Automatically falls back to wss:// based on NEXT_PUBLIC_API_URL if unset)
NEXT_PUBLIC_WS_URL=wss://ai-exam-proctor-platform-backend.onrender.com
